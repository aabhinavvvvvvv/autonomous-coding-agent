# Copy to .env and fill in real values. Never commit .env.
#
# NOTE (Milestone 0): no application code reads these yet. They document the
# configuration planned for upcoming milestones so it stays outside source code.

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Milestone 1 — sandbox runner
# Docker image used for sandboxed test execution (pinned by digest once built).
SANDBOX_IMAGE=agent-sandbox-python:dev

# Milestone 3 — model provider ("fake" needs no key and is used by tests)
MODEL_PROVIDER=fake
ANTHROPIC_API_KEY=replace-me

# Milestone 4 — persistence
DATABASE_URL=postgresql+psycopg://agent:replace-me@localhost:5432/agent_platform
